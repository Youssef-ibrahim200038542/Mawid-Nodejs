
<%- include("partials/header") %>

<div style="max-width: 420px; margin: 60px auto; padding: 35px; background: white; border: 1px solid #e2e8f0; border-radius: 12px;">

    <h1 style="text-align: center; color: #4f46e5; margin-bottom: 25px;">
        Sign up
    </h1>

    <% if (error) { %>
        <p style="color: #dc2626; background: #fef2f2; padding: 12px; border-radius: 6px;">
            <%= error %>
        </p>
    <% } %>

    <% if (typeof sent !== "undefined" && sent) { %>
        <p role="status" style="color: #0b6e4f; background: #ecf6f1; padding: 12px; border-radius: 6px;">
            Check your inbox. If this address can be used, we've sent a link to confirm it. Then log in.
        </p>
        <p style="text-align: center;"><a href="/login">Log in</a></p>
    <% } else { %>

    <form action="/signup" method="POST">

        <div style="margin-bottom: 20px;">
            <label style="display: block; margin-bottom: 8px; color: #334155;">
                Name:
            </label>
            <input
                type="text"
                name="name"
                id="name"
                value="<%= values.name %>"
                autocomplete="name"
                maxlength="100"
                required
                style="width: 100%; padding: 11px; box-sizing: border-box; border: 1px solid #cbd5e1; border-radius: 6px; outline: none;"
            >
        </div>

        <div style="margin-bottom: 20px;">
            <label style="display: block; margin-bottom: 8px; color: #334155;">
                Email:
            </label>
            <input
                type="email"
                name="email"
                id="email"
                value="<%= values.email %>"
                autocomplete="email"
                maxlength="255"
                required
                style="width: 100%; padding: 11px; box-sizing: border-box; border: 1px solid #cbd5e1; border-radius: 6px; outline: none;"
            >
        </div>

        <div style="margin-bottom: 25px;">
            <label style="display: block; margin-bottom: 8px; color: #334155;">
                Password:
            </label>
            <input
                type="password"
                name="password"
                id="password"
                minlength="8"
                maxlength="72"
                autocomplete="new-password"
                required
                style="width: 100%; padding: 11px; box-sizing: border-box; border: 1px solid #cbd5e1; border-radius: 6px; outline: none;"
            >
        </div>

        <button
            type="submit"
            style="width: 100%; padding: 12px; background: #4f46e5; color: white; border: none; border-radius: 6px; font-size: 16px; cursor: pointer;"
        >
            Sign up
        </button>

    </form>
    <% } %>
</div>

<%- include("partials/footer") %>
