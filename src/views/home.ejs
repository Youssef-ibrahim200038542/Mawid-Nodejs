
<%- include("partials/header") %>

<div style="max-width: 900px; margin: 70px auto; text-align: center; padding: 40px 20px; background: white; border-radius: 12px;">

    <h1 style="font-size: 42px; color: #4f46e5; margin-bottom: 20px;">
        Mawid
    </h1>

    <% if (user) { %>
        <p style="font-size: 18px; color: #475569;">
            Welcome, <%= user.name %>!
            <a href="/dashboard" style="color: #4f46e5; text-decoration: none; font-weight: bold;">
                Go to your dashboard
            </a>
        </p>
        <a href="/events/new" style="display: inline-block; margin-top: 16px; padding: 11px 16px; background: #4f46e5; color: white; border-radius: 6px; text-decoration: none;">
            Create an event
        </a>
    <% } else { %>
        <p style="font-size: 18px; color: #64748b; line-height: 1.7;">
            Create events, share a link, and collect RSVPs with a seat cap.
        </p>
    <% } %>

</div>

<%- include("partials/footer") %>
