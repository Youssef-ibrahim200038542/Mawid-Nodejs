<%- include("partials/header") %>

<section style="max-width: 900px; margin: 20px auto;">
    <div style="display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap;">
        <div>
            <h1 style="color: #4f46e5;">My events</h1>
            <p style="color: #64748b;">Create events, share registration links, and manage attendees.</p>
        </div>
        <a href="/events/new" style="padding: 11px 16px; background: #4f46e5; color: white; border-radius: 6px; text-decoration: none;">Create an event</a>
    </div>

    <% if (events.length === 0) { %>
        <p style="margin-top: 30px; padding: 24px; background: white; border: 1px solid #e2e8f0; border-radius: 8px;">You haven't created any events yet.</p>
    <% } %>

    <% events.forEach((event) => { %>
        <article style="margin-top: 20px; padding: 24px; background: white; border: 1px solid #e2e8f0; border-radius: 8px;">
            <h2 style="margin-top: 0;"><%= event.title %></h2>
            <p style="color: #64748b;">
                <%= event.startsAt.toLocaleString() %>
                <% if (event.location) { %> · <%= event.location %><% } %>
            </p>
            <p><strong><%= event._count.registrations %></strong> / <%= event.capacity %> registered</p>
            <p>
                Public registration link:
                <a href="/events/<%= event.slug %>"><%= `${requestOrigin}/events/${event.slug}` %></a>
            </p>
            <a href="/events/<%= event.slug %>/attendees" style="color: #4f46e5; font-weight: bold;">View attendee list</a>
        </article>
    <% }) %>
</section>

<%- include("partials/footer") %>
