<%- include("partials/header") %>

<section style="max-width: 600px; margin: 30px auto; padding: 30px; background: white; border: 1px solid #e2e8f0; border-radius: 12px;">
    <h1 style="color: #4f46e5;"><%= event.title %></h1>
    <p>Organized by <%= event.organizer.name %></p>
    <p><strong>Date:</strong> <%= event.startsAt.toLocaleString() %></p>
    <% if (event.location) { %><p><strong>Location:</strong> <%= event.location %></p><% } %>
    <p><strong>Available seats:</strong> <%= Math.max(0, event.capacity - event._count.registrations) %> of <%= event.capacity %></p>

    <% if (success) { %>
        <p style="color: #166534; background: #f0fdf4; padding: 12px; border-radius: 6px;">You're registered. See you there!</p>
    <% } %>
    <% if (error) { %>
        <p style="color: #dc2626; background: #fef2f2; padding: 12px; border-radius: 6px;"><%= error %></p>
    <% } %>

    <% if (event._count.registrations < event.capacity) { %>
        <h2>Register for this event</h2>
        <form action="/events/<%= event.slug %>/register" method="POST">
            <div style="margin-bottom: 18px;">
                <label for="name" style="display: block; margin-bottom: 7px;">Name</label>
                <input id="name" name="name" maxlength="100" required style="width: 100%; padding: 11px; box-sizing: border-box; border: 1px solid #cbd5e1; border-radius: 6px;">
            </div>
            <div style="margin-bottom: 24px;">
                <label for="email" style="display: block; margin-bottom: 7px;">Email</label>
                <input id="email" name="email" type="email" maxlength="255" required style="width: 100%; padding: 11px; box-sizing: border-box; border: 1px solid #cbd5e1; border-radius: 6px;">
            </div>
            <button type="submit" style="width: 100%; padding: 12px; background: #4f46e5; color: white; border: none; border-radius: 6px; font-size: 16px; cursor: pointer;">Register</button>
        </form>
    <% } else { %>
        <p style="color: #b91c1c; font-weight: bold;">This event is full.</p>
    <% } %>
</section>

<%- include("partials/footer") %>
