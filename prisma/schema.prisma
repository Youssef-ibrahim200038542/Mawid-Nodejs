generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id             Int            @id @default(autoincrement())
  name           String         @db.VarChar(100)
  email          String         @unique @db.VarChar(255)
  passwordHash   String         @map("password_hash") @db.VarChar(255)
  createdAt      DateTime       @default(now()) @map("created_at")
  platformRole   PlatformRole   @default(USER) @map("platform_role")
  locale         String         @default("en") @db.VarChar(5)
  // Account security (H1). NULL = the account never proved it controls its email address.
  emailVerifiedAt     DateTime?          @map("email_verified_at")
  // Stored in every session as `sv`; incrementing it invalidates all existing sessions.
  sessionVersion      Int                @default(0) @map("session_version")
  events              Event[]
  memberships         ClinicMember[]
  patientRecords      Patient[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  authTokens          AuthToken[]
  invitationsSent     ClinicInvitation[] @relation("InvitationInvitedBy")
  invitationsAccepted ClinicInvitation[] @relation("InvitationAcceptedBy")
  invitationsDeclined ClinicInvitation[] @relation("InvitationDeclinedBy")
  invitationsRevoked  ClinicInvitation[] @relation("InvitationRevokedBy")

  @@map("users")
}

// ---------------------------------------------------------------------------
// Clinic tenancy. Every tenant-owned table carries clinic_id.
// ---------------------------------------------------------------------------

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum ClinicStatus {
  ACTIVE
  SUSPENDED
}

// Management role inside one clinic. Being bookable as a doctor is a separate
// DoctorProfile (Phase 3), so an OWNER can also practise as a doctor.
enum ClinicRole {
  OWNER
  DOCTOR
  RECEPTIONIST
}

enum MemberStatus {
  ACTIVE
  DISABLED
}

model Clinic {
  id                 Int                 @id @default(autoincrement())
  slug               String              @unique @db.VarChar(80)
  name               String              @db.VarChar(150)
  timezone           String              @default("Africa/Cairo") @db.VarChar(64)
  defaultLocale      String              @default("en") @map("default_locale") @db.VarChar(5)
  status             ClinicStatus        @default(ACTIVE)
  phone              String?             @db.VarChar(30)
  email              String?             @db.VarChar(255)
  address            String?             @db.VarChar(255)
  city               String?             @db.VarChar(100)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  members            ClinicMember[]
  invitations        ClinicInvitation[]
  auditLogs          AuditLog[]
  specialties        Specialty[]
  services           Service[]
  doctors            DoctorProfile[]
  workingHours       WorkingHours[]
  scheduleExceptions ScheduleException[]
  patients           Patient[]
  notifications      Notification[]
  appointments       Appointment[]

  @@map("clinics")
}

model ClinicMember {
  id            Int            @id @default(autoincrement())
  clinicId      Int            @map("clinic_id")
  userId        Int            @map("user_id")
  role          ClinicRole
  status        MemberStatus   @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  // Membership trust (H1). Every membership that existed before account security is
  // LEGACY_UNREVIEWED; trust is only ever granted by src/modules/membership/membership-trust.service.js
  // (verified clinic creation, or an accepted invitation / re-confirmation). CHECK constraints in
  // the migration keep these four columns consistent.
  trustState             MemberTrustState   @default(LEGACY_UNREVIEWED) @map("trust_state")
  trustSource            MemberTrustSource? @map("trust_source")
  trustedAt              DateTime?          @map("trusted_at")
  trustedViaInvitationId Int?               @map("trusted_via_invitation_id")
  // Restrict: deleting a clinic or user must never silently cascade through tenant data.
  clinic                 Clinic             @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  user                   User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  doctorProfile          DoctorProfile?
  // The invitation that proved this membership; same clinic (composite key).
  trustedViaInvitation   ClinicInvitation?  @relation("MemberTrustedVia", fields: [clinicId, trustedViaInvitationId], references: [clinicId, id], onDelete: Restrict, onUpdate: NoAction)
  reconfirmations       ClinicInvitation[] @relation("InvitationMember")

  @@unique([clinicId, userId])
  // Target for composite foreign keys (clinic_id, member_id) so child rows cannot cross tenants.
  @@unique([clinicId, id])
  // One invitation can establish trust for one membership only.
  @@unique([clinicId, trustedViaInvitationId])
  @@index([userId])
  @@map("clinic_members")
}

enum MemberTrustState {
  LEGACY_UNREVIEWED
  TRUSTED
}

enum MemberTrustSource {
  CLINIC_CREATOR
  INVITATION
  RECONFIRMATION
}

enum InvitationKind {
  NEW_MEMBER
  RECONFIRM
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

// Staff invitations and legacy-membership re-confirmations. The raw token only exists in memory
// while the email is sent; token_hash rotates on every (re)send so older links stop working.
// active_key = sha256 of the "one open invitation" identity; NULL once the invitation is final,
// so the UNIQUE index enforces at most one PENDING invitation per clinic+email (or per member).
model ClinicInvitation {
  id               Int                 @id @default(autoincrement())
  clinicId         Int                 @map("clinic_id")
  kind             InvitationKind
  memberId         Int?                @map("member_id")
  email            String              @db.VarChar(255)
  role             ClinicRole
  status           InvitationStatus    @default(PENDING)
  activeKey        String?             @unique @map("active_key") @db.Char(64)
  tokenHash        String              @unique @map("token_hash") @db.Char(64)
  expiresAt        DateTime            @map("expires_at")
  invitedByUserId  Int?                @map("invited_by_user_id")
  lastSentAt       DateTime            @map("last_sent_at")
  sendCount        Int                 @default(1) @map("send_count")
  deliveryStatus   EmailDeliveryStatus @default(PENDING) @map("delivery_status")
  deliveryError    String?             @map("delivery_error") @db.VarChar(64)
  acceptedAt       DateTime?           @map("accepted_at")
  acceptedByUserId Int?                @map("accepted_by_user_id")
  declinedAt       DateTime?           @map("declined_at")
  declinedByUserId Int?                @map("declined_by_user_id")
  revokedAt        DateTime?           @map("revoked_at")
  revokedByUserId  Int?                @map("revoked_by_user_id")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  clinic           Clinic              @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  // RECONFIRM only: the existing membership being re-confirmed, in the same clinic.
  member           ClinicMember?       @relation("InvitationMember", fields: [clinicId, memberId], references: [clinicId, id], onDelete: Restrict, onUpdate: NoAction)
  invitedBy        User?               @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  acceptedBy       User?               @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  declinedBy       User?               @relation("InvitationDeclinedBy", fields: [declinedByUserId], references: [id], onDelete: SetNull)
  revokedBy        User?               @relation("InvitationRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  trustedMember    ClinicMember?       @relation("MemberTrustedVia")

  @@unique([clinicId, id])
  @@index([clinicId, status])
  @@index([email, status])
  @@map("clinic_invitations")
}

enum AuthTokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  // Not a usable token: a durable record of an "you already have an account" email.
  ACCOUNT_NOTICE
}

enum AuthTokenConsumedReason {
  USED
  SUPERSEDED
  EMAIL_CHANGED
  NOTICE
}

// QUEUED: generation stored, provider not called yet. SENDING: a provider attempt started
// (send_attempts was incremented). See docs/architecture/07-account-security.md.
enum AuthDeliveryStatus {
  QUEUED
  SENDING
  SENT
  RETRYABLE
  FAILED
  SKIPPED
  REPLACED
}

// Email verification / password reset tokens and account notices. Each row is one delivery
// generation; a retry creates a new row (new token) that replaces the previous one.
model AuthToken {
  id              Int                      @id @default(autoincrement())
  userId          Int                      @map("user_id")
  purpose         AuthTokenPurpose
  // Normalised email the token was issued for; a token is invalid once the account email differs.
  email           String                   @db.VarChar(255)
  tokenHash       String                   @unique @map("token_hash") @db.Char(64)
  createdAt       DateTime                 @default(now()) @map("created_at")
  expiresAt       DateTime                 @map("expires_at")
  consumedAt      DateTime?                @map("consumed_at")
  consumedReason  AuthTokenConsumedReason? @map("consumed_reason")
  // When the first generation of this delivery chain was created (bounds recovery).
  chainStartedAt  DateTime                 @map("chain_started_at")
  replacesTokenId Int?                     @unique @map("replaces_token_id")
  // Actual provider send attempts made for the whole chain (inherited by replacements).
  sendAttempts    Int                      @default(0) @map("send_attempts") @db.SmallInt
  deliveryStatus  AuthDeliveryStatus       @default(QUEUED) @map("delivery_status")
  nextRetryAt     DateTime?                @map("next_retry_at")
  deliveryError   String?                  @map("delivery_error") @db.VarChar(64)
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replaces        AuthToken?               @relation("AuthTokenReplacement", fields: [replacesTokenId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  replacedBy      AuthToken?               @relation("AuthTokenReplacement")

  @@index([userId, purpose, consumedAt])
  @@index([deliveryStatus, nextRetryAt])
  @@index([expiresAt])
  @@map("auth_tokens")
}

enum AuthRateKind {
  SIGNUP
  PASSWORD_RESET
}

// Fixed-window per-email counters for signup / password reset. key_hash is an HMAC of the
// normalised email (never the email itself, never an IP). Incremented with one atomic
// INSERT … ON DUPLICATE KEY UPDATE, so concurrent requests on any instance cannot bypass it.
model AuthRateBucket {
  kind         AuthRateKind
  keyHash      String       @map("key_hash") @db.Char(64)
  windowStart  DateTime     @map("window_start")
  requestCount Int          @default(1) @map("request_count")

  @@id([kind, keyHash, windowStart])
  @@index([windowStart])
  @@map("auth_rate_buckets")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorUserId Int?     @map("actor_user_id")
  clinicId    Int?     @map("clinic_id")
  action      String   @db.VarChar(80)
  targetType  String?  @map("target_type") @db.VarChar(50)
  targetId    String?  @map("target_id") @db.VarChar(64)
  metadata    Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at")
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  clinic      Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@index([clinicId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Clinic operations (Phase 3). Every table carries clinic_id, and every link
// between tenant rows uses a composite foreign key (clinic_id, <id>) so the
// database itself rejects a doctor, specialty or service from another clinic.
// ---------------------------------------------------------------------------

model Specialty {
  id        Int               @id @default(autoincrement())
  clinicId  Int               @map("clinic_id")
  nameEn    String            @map("name_en") @db.VarChar(100)
  nameAr    String?           @map("name_ar") @db.VarChar(100)
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  clinic    Clinic            @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctors   DoctorSpecialty[]

  // Collation is case-insensitive, so "Dentistry" and "dentistry" collide too.
  @@unique([clinicId, nameEn])
  @@unique([clinicId, nameAr])
  @@unique([clinicId, id])
  @@map("specialties")
}

model Service {
  id              Int             @id @default(autoincrement())
  clinicId        Int             @map("clinic_id")
  nameEn          String          @map("name_en") @db.VarChar(150)
  nameAr          String?         @map("name_ar") @db.VarChar(150)
  descriptionEn   String?         @map("description_en") @db.Text
  descriptionAr   String?         @map("description_ar") @db.Text
  durationMinutes Int             @map("duration_minutes")
  // Money as integer minor units (piasters for EGP) — never floats.
  priceMinor      Int             @map("price_minor")
  currency        String          @default("EGP") @db.VarChar(3)
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  clinic          Clinic          @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctors         DoctorService[]
  appointments    Appointment[]

  @@unique([clinicId, nameEn])
  @@unique([clinicId, nameAr])
  @@unique([clinicId, id])
  @@map("services")
}

model DoctorProfile {
  id                 Int                 @id @default(autoincrement())
  clinicId           Int                 @map("clinic_id")
  memberId           Int                 @unique @map("member_id")
  displayNameEn      String              @map("display_name_en") @db.VarChar(150)
  displayNameAr      String?             @map("display_name_ar") @db.VarChar(150)
  titleEn            String?             @map("title_en") @db.VarChar(100)
  titleAr            String?             @map("title_ar") @db.VarChar(100)
  bioEn              String?             @map("bio_en") @db.Text
  bioAr              String?             @map("bio_ar") @db.Text
  yearsOfExperience  Int?                @map("years_of_experience")
  licenseNumber      String?             @map("license_number") @db.VarChar(64)
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  clinic             Clinic              @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  member             ClinicMember        @relation(fields: [clinicId, memberId], references: [clinicId, id], onDelete: Restrict)
  specialties        DoctorSpecialty[]
  services           DoctorService[]
  workingHours       WorkingHours[]
  scheduleExceptions ScheduleException[]
  appointments       Appointment[]

  @@unique([clinicId, memberId])
  @@unique([clinicId, id])
  @@map("doctor_profiles")
}

model DoctorSpecialty {
  clinicId    Int           @map("clinic_id")
  doctorId    Int           @map("doctor_id")
  specialtyId Int           @map("specialty_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  doctor      DoctorProfile @relation(fields: [clinicId, doctorId], references: [clinicId, id], onDelete: Cascade)
  specialty   Specialty     @relation(fields: [clinicId, specialtyId], references: [clinicId, id], onDelete: Cascade)

  @@id([doctorId, specialtyId])
  @@index([clinicId, specialtyId])
  @@map("doctor_specialties")
}

model DoctorService {
  clinicId  Int           @map("clinic_id")
  doctorId  Int           @map("doctor_id")
  serviceId Int           @map("service_id")
  createdAt DateTime      @default(now()) @map("created_at")
  doctor    DoctorProfile @relation(fields: [clinicId, doctorId], references: [clinicId, id], onDelete: Cascade)
  service   Service       @relation(fields: [clinicId, serviceId], references: [clinicId, id], onDelete: Cascade)

  @@id([doctorId, serviceId])
  @@index([clinicId, serviceId])
  @@map("doctor_services")
}

// Weekly recurring hours as wall-clock minutes in the clinic's IANA timezone, so a
// DST change never shifts "09:00". doctor_id NULL = the clinic's own opening hours.
// Breaks are gaps between intervals on the same weekday (09:00–13:00, 14:00–18:00).
model WorkingHours {
  id          Int            @id @default(autoincrement())
  clinicId    Int            @map("clinic_id")
  doctorId    Int?           @map("doctor_id")
  // ISO weekday: 1 = Monday … 7 = Sunday.
  weekday     Int            @db.TinyInt
  startMinute Int            @map("start_minute") @db.SmallInt
  endMinute   Int            @map("end_minute") @db.SmallInt
  createdAt   DateTime       @default(now()) @map("created_at")
  clinic      Clinic         @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctor      DoctorProfile? @relation(fields: [clinicId, doctorId], references: [clinicId, id], onDelete: Cascade)

  @@index([clinicId, doctorId, weekday])
  @@map("working_hours")
}

enum ScheduleExceptionKind {
  HOLIDAY
  LEAVE
  UNAVAILABLE
}

// A period when the clinic (doctor_id NULL) or one doctor cannot take appointments.
// Absolute instants, stored in UTC.
model ScheduleException {
  id              Int                   @id @default(autoincrement())
  clinicId        Int                   @map("clinic_id")
  doctorId        Int?                  @map("doctor_id")
  kind            ScheduleExceptionKind
  startsAt        DateTime              @map("starts_at")
  endsAt          DateTime              @map("ends_at")
  reason          String?               @db.VarChar(255)
  createdByUserId Int?                  @map("created_by_user_id")
  createdAt       DateTime              @default(now()) @map("created_at")
  clinic          Clinic                @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctor          DoctorProfile?        @relation(fields: [clinicId, doctorId], references: [clinicId, id], onDelete: Cascade)

  @@index([clinicId, startsAt])
  @@index([doctorId, startsAt])
  @@map("schedule_exceptions")
}

// ---------------------------------------------------------------------------
// Appointments (Phase 4). Patients are clinic-scoped records; a patient may be
// linked to a platform user account (online booking) or not (walk-in created by staff).
// No medical data is stored here by design.
// ---------------------------------------------------------------------------

model Patient {
  id           Int           @id @default(autoincrement())
  clinicId     Int           @map("clinic_id")
  userId       Int?          @map("user_id")
  fullName     String        @map("full_name") @db.VarChar(150)
  phone        String?       @db.VarChar(30)
  email        String?       @db.VarChar(255)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  // One record per account per clinic; walk-ins (user_id NULL) are unrestricted.
  @@unique([clinicId, userId])
  @@unique([clinicId, id])
  @@index([clinicId, phone])
  @@index([clinicId, email])
  @@index([userId])
  @@map("patients")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AppointmentSource {
  ONLINE
  STAFF
}

model Appointment {
  id                 Int               @id @default(autoincrement())
  clinicId           Int               @map("clinic_id")
  doctorId           Int               @map("doctor_id")
  serviceId          Int               @map("service_id")
  patientId          Int               @map("patient_id")
  startsAt           DateTime          @map("starts_at")
  endsAt             DateTime          @map("ends_at")
  status             AppointmentStatus @default(PENDING)
  source             AppointmentSource
  // Snapshot of the service at booking time, so later price edits never change past bookings.
  durationMinutes    Int               @map("duration_minutes")
  priceMinor         Int               @map("price_minor")
  currency           String            @db.VarChar(3)
  // Administrative note only (e.g. "prefers Arabic"); never clinical information.
  note               String?           @db.VarChar(500)
  createdByUserId    Int?              @map("created_by_user_id")
  confirmedAt        DateTime?         @map("confirmed_at")
  cancelledAt        DateTime?         @map("cancelled_at")
  cancelledByUserId  Int?              @map("cancelled_by_user_id")
  cancellationReason String?           @map("cancellation_reason") @db.VarChar(255)
  rescheduleCount    Int               @default(0) @map("reschedule_count")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  clinic             Clinic            @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctor             DoctorProfile     @relation(fields: [clinicId, doctorId], references: [clinicId, id], onDelete: Restrict)
  service            Service           @relation(fields: [clinicId, serviceId], references: [clinicId, id], onDelete: Restrict)
  patient            Patient           @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Restrict)
  notifications      Notification[]

  @@unique([clinicId, id])
  @@index([doctorId, startsAt])
  @@index([clinicId, startsAt])
  @@index([patientId, startsAt])
  @@index([clinicId, status, startsAt])
  @@map("appointments")
}

// ---------------------------------------------------------------------------
// Notifications (in-app first; email is a pluggable delivery channel).
// The payload carries ids and names, and the frontend renders localized text (en/ar) from `type`.
// ---------------------------------------------------------------------------

enum NotificationType {
  APPOINTMENT_BOOKED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_REMINDER
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Notification {
  id            Int                 @id @default(autoincrement())
  userId        Int                 @map("user_id")
  clinicId      Int?                @map("clinic_id")
  appointmentId Int?                @map("appointment_id")
  type          NotificationType
  payload       Json
  readAt        DateTime?           @map("read_at")
  emailStatus   EmailDeliveryStatus @default(PENDING) @map("email_status")
  emailError    String?             @map("email_error") @db.VarChar(255)
  // Makes scheduled jobs (reminders) idempotent: the same key is never notified twice.
  dedupeKey     String?             @unique @map("dedupe_key") @db.VarChar(120)
  createdAt     DateTime            @default(now()) @map("created_at")
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic        Clinic?             @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  appointment   Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([emailStatus, createdAt])
  @@map("notifications")
}

model Event {
  id            Int            @id @default(autoincrement())
  organizerId   Int            @map("organizer_id")
  slug          String         @unique @db.VarChar(120)
  title         String         @db.VarChar(200)
  location      String?        @db.VarChar(255)
  startsAt      DateTime       @map("starts_at")
  capacity      Int
  createdAt     DateTime       @default(now()) @map("created_at")
  organizer     User           @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  registrations Registration[]

  @@map("events")
}

model Registration {
  id        Int      @id @default(autoincrement())
  eventId   Int      @map("event_id")
  name      String   @db.VarChar(100)
  email     String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@map("registrations")
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String   @db.MediumText
  expiresAt DateTime @map("expires_at")

  @@map("sessions")
}
