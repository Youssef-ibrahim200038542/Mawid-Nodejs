{
  "name": "nodejs-learning",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "prisma generate && nodemon src/index.js",
    "migrate": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "migrate:diff": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --script",
    "start": "prisma generate && node src/index.js",
    "test": "node --test --require ./tests/unit-env.js \"tests/*.test.js\"",
    "race": "node scripts/race.js",
    "test:db:migrate": "node scripts/test-db.js",
    "test:integration": "node scripts/test-db.js && node --test --test-concurrency=1 --test-timeout=30000 --require ./tests/integration/env.js \"tests/integration/*.test.js\"",
    "dev:test-db": "node scripts/dev-test-server.js",
    "web:dev": "node scripts/dev-web-test.js",
    "web:build": "npm --prefix web run build",
    "web:typecheck": "npm --prefix web run typecheck",
    "start:prod": "node src/index.js",
    "build:prod": "prisma generate && npm --prefix web ci && npm --prefix web run build",
    "db:verify-privileges": "node scripts/verify-db-privileges.js",
    "db:review-memberships": "node scripts/review-memberships.js"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@quixo3/prisma-session-store": "^3.1.21",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.10",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "luxon": "^3.7.2",
    "mariadb": "^3.5.5",
    "nodemailer": "^10.6.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^7.10.1"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
