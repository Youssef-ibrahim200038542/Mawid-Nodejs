
# Application
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mawid

# Prisma
DATABASE_URL="mysql://root@127.0.0.1:3306/mawid"

# Session
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Logging (trace | debug | info | warn | error | fatal | silent)
LOG_LEVEL=info

# Email (account verification, password reset, staff invitations)
# Development: none (nothing sent) | log (masked recipient + subject only) | outbox (writes
# var/mail-outbox/*.json, git-ignored; refused in production). Production refuses to start
# until a real provider is configured.
EMAIL_PROVIDER=none
EMAIL_FROM=
# Origin of the web app used in email links (https:// in production). Default: http://localhost:5173
WEB_APP_URL=

# ---- Production (see docs/operations/deployment.md)
# Runtime DB account must be the least-privilege `mawid_app` (deploy/database/create-accounts.sql);
# production refuses root and refuses DATABASE_URL (migration credentials) in the app process.
# DB_CONNECTION_LIMIT=5
# DB_ACQUIRE_TIMEOUT_MS=10000
# SERVE_WEB=1            serve web/dist from this process (run `npm run web:build` first)
# TRUST_PROXY=1          number of reverse-proxy hops in front of the app
# ENFORCE_HTTPS=1        redirect / refuse plain HTTP (default on in production)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false      true = implicit TLS (port 465); otherwise STARTTLS is required
# SMTP_USER=
# SMTP_PASSWORD=
