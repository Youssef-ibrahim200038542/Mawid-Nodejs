# Integration tests ONLY. Copy to .env.test (gitignored).
# Every value must point at the mawid_test database — the test harness refuses to run otherwise
# and never falls back to .env.
NODE_ENV=test
LOG_LEVEL=silent
APP_URL=http://127.0.0.1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mawid_test
DATABASE_URL="mysql://root@127.0.0.1:3306/mawid_test"

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Email for the local dev stack (npm run dev:test-db). outbox writes var/mail-outbox/*.json.
EMAIL_PROVIDER=outbox
WEB_APP_URL=http://localhost:5173
