# Mawid — production APP runtime environment (template; placeholders only).
# Install as /etc/mawid/mawid.env (owner root, mode 0600). Never commit the real file.
# The app refuses to start if any rule below is broken (src/config/startup-checks.js,
# src/config/db-privileges.js). Variables are read from the process environment; nothing
# falls back to development values.

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Public origin (https only). Used for email links and HTTPS redirects — never the Host header.
APP_URL=https://<your-domain>
WEB_APP_URL=https://<your-domain>

# ≥ 32 random bytes: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=<random-secret>

# Runtime database account: least-privilege mawid_app (SELECT, INSERT, UPDATE, DELETE on mawid only).
# Root / admin users are refused; DB_PASSWORD must be ≥ 16 characters.
DB_HOST=<db-host>
DB_PORT=3306
DB_NAME=mawid
DB_USER=mawid_app
DB_PASSWORD=<app-db-password>
DB_CONNECTION_LIMIT=5
DB_ACQUIRE_TIMEOUT_MS=10000
# DATABASE_URL must NOT be set here (migration credentials belong only to the migration job).

# Serving behind nginx (one proxy hop), the built SPA from this process, HTTPS enforced.
SERVE_WEB=1
TRUST_PROXY=1
ENFORCE_HTTPS=1

# Email (required: verification, password reset and invitations depend on it).
EMAIL_PROVIDER=smtp
EMAIL_FROM=Mawid <no-reply@<your-domain>>
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-user>
SMTP_PASSWORD=<smtp-password>
